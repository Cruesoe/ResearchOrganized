<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>ResearchOrganized.Tests</RootNamespace>
    <AssemblyName>ResearchOrganized.Tests</AssemblyName>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <!-- A plain console host, not a shipped mod assembly: no RimWorld or Unity
         references, and nothing to copy into 1.6\Assemblies. -->
    <IsRimWorldMod>false</IsRimWorldMod>
  </PropertyGroup>
  <ItemGroup>
    <!--
      The layout core is linked in rather than referenced, because the mod assembly itself
      references RimWorld and Unity and could not load in a plain console host. Everything
      under Source\Layout is deliberately free of those dependencies so it can be tested here.
    -->
    <Compile Include="..\Source\Layout\*.cs" LinkBase="Layout" />
  </ItemGroup>
</Project>
