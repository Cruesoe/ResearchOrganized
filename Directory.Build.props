<Project>
  <!-- Repository-local build settings for Research: Organized. -->
  <PropertyGroup>
    <!-- Test projects opt out in their project file. -->
    <IsRimWorldMod Condition="'$(IsRimWorldMod)' == ''">true</IsRimWorldMod>
    <RimWorldGameVersion Condition="'$(RimWorldGameVersion)' == ''">1.6</RimWorldGameVersion>

    <TargetFramework>net472</TargetFramework>
    <LangVersion Condition="'$(LangVersion)' == ''">latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Deterministic>true</Deterministic>
    <GenerateAssemblyInfo Condition="'$(GenerateAssemblyInfo)' == ''">false</GenerateAssemblyInfo>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DebugType Condition="'$(DebugType)' == ''">full</DebugType>
    <DebugSymbols Condition="'$(DebugSymbols)' == ''">true</DebugSymbols>
    <Optimize Condition="'$(Optimize)' == ''">false</Optimize>
    <DefineConstants>$(DefineConstants);DEBUG;TRACE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' != 'Debug'">
    <DebugType Condition="'$(DebugType)' == ''">none</DebugType>
    <DebugSymbols Condition="'$(DebugSymbols)' == ''">false</DebugSymbols>
    <Optimize Condition="'$(Optimize)' == ''">true</Optimize>
    <DefineConstants>$(DefineConstants);TRACE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Explicit MSBuild property, then environment variable, then local Steam default. -->
    <RimWorldRoot Condition="'$(RimWorldRoot)' == ''">$(RIMWORLD_DIR)</RimWorldRoot>
    <RimWorldRoot Condition="'$(RimWorldRoot)' == ''">C:\Program Files (x86)\Steam\steamapps\common\RimWorld</RimWorldRoot>
    <RimWorldManaged Condition="'$(RimWorldManaged)' == ''">$(RimWorldRoot)\RimWorldWin64_Data\Managed</RimWorldManaged>

    <HarmonyDll Condition="'$(HarmonyDll)' == ''">$(HARMONY_DLL)</HarmonyDll>
    <HarmonyDll Condition="'$(HarmonyDll)' == ''">C:\Program Files (x86)\Steam\steamapps\workshop\content\294100\2009463077\Current\Assemblies\0Harmony.dll</HarmonyDll>

    <UnityModules Condition="'$(UnityModules)' == ''">CoreModule;IMGUIModule;TextRenderingModule;InputLegacyModule</UnityModules>

    <!-- Release builds stage the loadable assembly in the repository's version folder. -->
    <ModRepoRoot Condition="'$(ModRepoRoot)' == ''">$(MSBuildThisFileDirectory)</ModRepoRoot>
    <ModRepoRoot>$([MSBuild]::EnsureTrailingSlash('$(ModRepoRoot)'))</ModRepoRoot>
    <ModAssemblies Condition="'$(ModAssemblies)' == ''">$(ModRepoRoot)$(RimWorldGameVersion)\Assemblies\</ModAssemblies>
  </PropertyGroup>
</Project>
