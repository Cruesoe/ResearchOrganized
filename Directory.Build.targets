<Project>
  <Target Name="VerifyRimWorldReferences"
          BeforeTargets="ResolveAssemblyReferences"
          Condition="'$(IsRimWorldMod)' == 'true'">
    <Error Condition="!Exists('$(RimWorldManaged)\Assembly-CSharp.dll')"
           Text="RimWorld assemblies not found at '$(RimWorldManaged)'. Set RIMWORLD_DIR to the RimWorld install folder, or pass -p:RimWorldRoot=..." />
    <Error Condition="'$(UseHarmony)' != 'false' and !Exists('$(HarmonyDll)')"
           Text="0Harmony.dll not found at '$(HarmonyDll)'. Subscribe to the Harmony workshop item, set HARMONY_DLL, or set &lt;UseHarmony&gt;false&lt;/UseHarmony&gt; if this mod does not patch." />
  </Target>

  <ItemGroup Condition="'$(IsRimWorldMod)' == 'true'">
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RimWorldManaged)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony" Condition="'$(UseHarmony)' != 'false'">
      <HintPath>$(HarmonyDll)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="'$(IsRimWorldMod)' == 'true'">
    <_RimWorldUnityModule Include="$(UnityModules)" />
    <Reference Include="@(_RimWorldUnityModule->'UnityEngine.%(Identity)')">
      <HintPath>$(RimWorldManaged)\%(Identity).dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="CopyToModAssemblies"
          AfterTargets="Build"
          Condition="'$(IsRimWorldMod)' == 'true' and '$(CopyToModAssemblies)' != 'false'">
    <MakeDir Directories="$(ModAssemblies)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModAssemblies)" SkipUnchangedFiles="true" />
    <Delete Files="$(ModAssemblies)$(TargetName).pdb" Condition="Exists('$(ModAssemblies)$(TargetName).pdb')" />
    <Message Importance="high" Text="  -> $(ModAssemblies)$(TargetFileName)" />
  </Target>
</Project>
